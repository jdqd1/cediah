    "fastify": "5.11.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.1.2",
    "eslint": "9.39.5",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }

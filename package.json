{
  "name": "cediah-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "db:migrate": "pnpm --filter @cediah/api migrate",
    "dev": "pnpm --filter @cediah/contracts build && pnpm --parallel --filter @cediah/api --filter @cediah/web dev",
    "dev:api": "pnpm --filter @cediah/contracts build && pnpm --filter @cediah/api dev",
    "dev:web": "pnpm --filter @cediah/contracts build && pnpm --filter @cediah/web dev",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}

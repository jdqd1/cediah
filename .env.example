# Public web configuration. The Supabase publishable key is intentionally public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only web configuration.
API_BASE_URL=http://127.0.0.1:4000

# API configuration.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Private test-video flow. Configure these only on the API server, never in Vercel
# public variables. The feature remains disabled until every value is configured.
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
VIDEO_TEST_UPLOAD_ENABLED=false
VIDEO_TEST_UPLOADER_IDS=
VIDEO_TEST_MAX_DURATION_SECONDS=900
VIDEO_TEST_MAX_FILE_BYTES=190000000

# Never add database passwords, Supabase secret/service keys or payment secrets here.

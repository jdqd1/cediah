# Public web configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_VIDEO_STORAGE_ORIGIN=https://your-project-ref.storage.supabase.co

# Server-only web configuration.
API_BASE_URL=http://127.0.0.1:4000

# API configuration.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Portable PostgreSQL and Better Auth. Keep these values only on the API.
DATABASE_URL=postgresql://cediah:replace_me@127.0.0.1:5432/cediah
DATABASE_MIGRATIONS_ENABLED=true
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Uncomment SMTP settings to enable password recovery and email verification.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=replace_me
# SMTP_PASSWORD=replace_me
# SMTP_FROM=acceso@example.com
# TURNSTILE_SECRET_KEY=replace_me

# Private test-video flow. Configure these only on the API server, never in Vercel
# public variables. Supabase is accessed only through its S3-compatible Storage API.
VIDEO_TEST_PROVIDER=s3
STORAGE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=replace_with_storage_access_key
STORAGE_S3_SECRET_ACCESS_KEY=replace_with_storage_secret_key
STORAGE_S3_FORCE_PATH_STYLE=true
VIDEO_STORAGE_BUCKET=video-test
# CLOUDFLARE_STREAM_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
# CLOUDFLARE_STREAM_CUSTOMER_CODE=
VIDEO_TEST_UPLOAD_ENABLED=false
VIDEO_TEST_UPLOADER_IDS=
VIDEO_TEST_MAX_DURATION_SECONDS=900
VIDEO_TEST_MAX_FILE_BYTES=50000000

# Never expose database, auth, SMTP or storage secrets with a NEXT_PUBLIC_ prefix.
